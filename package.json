{
	"name": "prismjs",
	"version": "2.0.0-alpha.1",
	"description": "Lightweight, robust, elegant syntax highlighting.",
	"type": "module",
	"main": "./dist/cjs/index.js",
	"module": "./dist/index.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./core.js": {
			"types": "./types/core.d.ts",
			"import": "./dist/core.js",
			"require": "./dist/cjs/core.js"
		},
		"./global.js": {
			"types": "./types/global.d.ts",
			"import": "./dist/global.js",
			"require": "./dist/cjs/global.js"
		},
		"./shared.js": {
			"types": "./types/shared.d.ts",
			"import": "./dist/shared.js",
			"require": "./dist/cjs/shared.js"
		},
		"./languages/*.js": {
			"types": "./types/languages/*.d.ts",
			"import": "./dist/languages/*.js",
			"require": "./dist/cjs/languages/*.js"
		},
		"./plugins/*.js": {
			"types": "./types/plugins/*/*.d.ts",
			"import": "./dist/plugins/*.js",
			"require": "./dist/cjs/plugins/*.js"
		},
		"./plugins/*.css": "./dist/plugins/*.css",
		"./themes/*.css": "./dist/themes/*.css",
		"./components.json": "./dist/components.json"
	},
	"style": "dist/themes/prism.css",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"benchmark": "node benchmark/benchmark.js",
		"build": "node scripts/build.js",
		"prepack": "npm run build",
		"prepare": "husky",
		"lint": "eslint . --cache",
		"lint:fix": "npm run lint -- --fix",
		"lint:ci": "eslint . --max-warnings 0",
		"regex-coverage": "mocha tests/coverage.js",
		"release": "npm whoami >/dev/null 2>&1 || npm login && release-it",
		"test:components": "mocha tests/components-test.js",
		"test:core": "mocha tests/core/**/*.js",
		"test:identifiers": "mocha tests/identifier-test.js",
		"test:languages": "mocha tests/run.js",
		"test:patterns": "mocha tests/pattern-tests.js",
		"test:plugins": "mocha tests/plugins/**/*.js",
		"test:runner": "mocha tests/testrunner-tests.js",
		"test": "npm-run-all test:*",
		"typecheck:core": "tsc",
		"typecheck:tests": "tsc -p tests/tsconfig.json",
		"typecheck": "npm-run-all typecheck:*"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PrismJS/prism.git"
	},
	"keywords": [
		"prism",
		"highlight"
	],
	"author": "Lea Verou",
	"license": "MIT",
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/prismjs"
	},
	"readmeFilename": "README.md",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.1",
		"@prettier/sync": "^0.6.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@types/benchmark": "^2.1.5",
		"@types/chai": "^5.2.3",
		"@types/clean-css": "^4.2.11",
		"@types/jsdom": "^21.1.7",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@types/yargs": "^17.0.35",
		"benchmark": "^2.1.4",
		"chai": "^5.3.3",
		"clean-css": "^5.3.3",
		"cross-fetch": "^4.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-jsdoc": "^50.8.0",
		"eslint-plugin-regexp": "^2.10.0",
		"globals": "^16.5.0",
		"htmlparser2": "^10.1.0",
		"husky": "^9.1.7",
		"jsdom": "^24.1.3",
		"lint-staged": "^16.4.0",
		"magic-string": "^0.30.21",
		"mocha": "^12.0.3",
		"mocha-chai-jest-snapshot": "^1.1.7",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.5.3",
		"prettier-plugin-brace-style": "^0.10.4",
		"prettier-plugin-merge": "^0.10.2",
		"prettier-plugin-space-before-function-paren": "^0.0.10",
		"refa": "^0.9.1",
		"regexp-ast-analysis": "^0.5.1",
		"regexpp": "^3.2.0",
		"release-it": "^21.1.2",
		"rollup": "^4.68.2",
		"scslre": "^0.3.0",
		"simple-git": "^4.0.2",
		"typescript": "^5.8.3",
		"webfont": "^11.2.26",
		"yargs": "^17.7.3"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	}
}
