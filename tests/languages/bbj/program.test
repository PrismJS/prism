rem ' Greeter sample
use java.util.HashMap
use ::lib/util.bbj::Util

rem /**
rem  * A friendly greeter.
rem  */
class public Greeter extends Util implements Runnable
    field private BBjString Name$
    field private java.util.HashMap cache!

    method public Greeter(BBjString name$)
        #Name$ = name$
        #cache! = new java.util.HashMap()
    methodend

    method public BBjString greet(BBjNumber times%)
        if times% <= 0 then methodret ""
        msg$ = "Hello, """ + #Name$ + """!"
        for i = 1 to times%
            print 'BOLD', msg$, $0D0A$
        next i
        methodret msg$
    methodend
classend

0010 OPEN (1,ERR=oops)"greet.dat"
0020 READ (1,KEY="A",ERR=oops)a$
oops:
    seterr 0
    declare auto Greeter g!
    g! = new Greeter("BBj")
    x$ = g!.greet(3); rem say hi
    if BBjAPI.TRUE and len(x$) > 0 then gosub done
done:
    return

----------------------------------------------------

