$s = "it's";
// 'a' b
$s = 'c';

$s = "it's";
/* 'a' */
$s = 'c';

# a ?> b

$where = "IN ('" . implode( "', '", array_map( 'esc_sql', $names ) ) . "')";
// 'childless' terms
$childless = $args['childless'];

