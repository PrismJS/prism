	'''
	key: 'value'
	404: 1
	2026-09-19T14:00:00Z
	30s
	'''
escaped:
	"""
	keeps \n and \" escapes
	"""
literal-after-comment: /*'*/'''
literal content
'''
escaped-after-comment: /*"*/"""
escaped content
"""
items: [/*'*/'''
literal item
''',/*"*/"""
escaped item
"""]

