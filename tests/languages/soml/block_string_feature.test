	["key", "prose"], ["punctuation", ":"],
	["block-string", "'''\r\n\tTerminates TLS.\r\n\tRoutes requests to internal services.\r\n\t'''"],
	["key", "symbols"], ["punctuation", ":"],
	["block-string", "'''\r\n\t# not a comment\r\n\t/* not a comment */\r\n\t'''"],
