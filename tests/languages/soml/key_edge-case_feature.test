404: 'not found'
-foo: 1
_private: 2
7zip-bin: 'x'
'the name': 'space'
'a.b': 'dot'
'a:b': 'colon'
'#hash': 'hash'
'a/*b': 'comment marker'
true: 1
null: 2
infinity: 3
30s: 4
pool: {min: 2, max: 16}
nested: {
	deep: {
		deeper: 1
	}
}

