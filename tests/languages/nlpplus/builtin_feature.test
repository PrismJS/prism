@DECL
AddWord(L("w")) { return addword(L("w")); }
@@DECL
@CODE
L("n") = strlength("abc");
L("s") = StrLength("abc");
L("j") = LJ(L("n"), 5);
L("p") = DICTphraselookup(L("x"));
L("r") = refind("a+", L("x"));
push(L("arr"), 1);
@@CODE
@RULES
_x <- next single [s] @@

