----------------------------------------------------

[
	["region", "@NODES"],
	["constant", "_ROOT"],
	["region", "@PATH"],
	["constant", "_ROOT"],
	["node", "_paragraph"],
	["node", "_sentence"],
	["region", "@CODE"],
	["region", "@@CODE"],
	["region", "@POSTCODE"],
	["region", "@@POSTCODE"],
	["region", "@RULES"],
	["node", "_np"],
	["arrow", "<-"],
	["node", "_det"],
	["node", "_noun"],
	["rule-end", "@@"],
	["region", "@@RULES"],
	["region", "@post"],
	["region", "@@post"],
	["region", "@PRE"],
	["region", "@@PRE"],
	["region", "@CHECK"],
	["region", "@@CHECK"],
	["region", "@POST"],
	["region", "@@POST"],
	["region", "@MULTI"],
	["region", "@@MULTI"],
	["region", "@RECURSE"],
	" listarg\r\n",
	["region", "@@RECURSE"],
	" listarg\r\n",
	["region", "@SELECT"],
	["region", "@@SELECT"],
	"\r\n@GROUP"
]

----------------------------------------------------

Checks for region markers and their closing forms. @GROUP is not a marker
(the engine reports a syntax error), so it stays plain text.
