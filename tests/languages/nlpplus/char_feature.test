_abbr <- _xALPHA \. @@
_word <- \- \, @@

----------------------------------------------------

[
	["node", "_abbr"],
	["arrow", "<-"],
	["constant", "_xALPHA"],
	["char", "\\."],
	["region", "@@"],

	["node", "_word"],
	["arrow", "<-"],
	["char", "\\-"],
	["char", "\\,"],
	["region", "@@"]
]

----------------------------------------------------

Checks for backslash-escaped literal characters in rules.
