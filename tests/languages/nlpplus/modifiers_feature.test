_np [base] <- _xWILD [min=2 match=(_xCAP _xNUM)] _xEMOJI _xEND @@
_asset <- in [s] cash @@
_coord [layer=_noun] <-
_xWILD [s plus fails=(\. \? \! _paragraphSeparator)]
_cLF [base layer=(_LIT )] <- \\ n [ren=\n] @@
_xNIL <- _xALPHA [regexp="t*"] @@
_xWILD [s one matches=("_xALPHA" "_" ":")]
_xALPHA [s one matches=("#PCDATA")] ### (4)
_STMTS [base] <- _xWILD [s one match=(_STMT _EXPR
	_BLOCK	# 12/15/99 AM.
	)] @@
_x <- _xALPHA _xANY _xBLANK _xCAP _xCAPLET _xCTRL _xEOF _xLET _xNIL _xNUM _xPUNCT _xSTART _xWHITE @@

