_x <- _xALPHA [one vareq=("pos" "noun") plus] @@
_x <- _xWILD [one match=( \) \] \} )] @@
_x <- _xWILD [one lookahead match=(_xCAP \( \[ \< \" )] @@
_x <- _xALPHA [xs dejunk dj xtree cap regexp="^h" varz=("x")] @@
_x <- _xALPHA [s look S LOOK T OPT] @@
_x <- _xALPHA [da dcc deacc dj xs s look] @@
_x <- _xALPHA [attrs base debug deaccent excepts fails gp group layers length lengthr lowercase matches max min nest numrange o optional passes recurse regexpi rename singlet star tree trigger unknown unsealed uppercase var vargt varlt varne xsinglet xt] @@
_x <- _xWILD [match=(one look base group s)] @@

