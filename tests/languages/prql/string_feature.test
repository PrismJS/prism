[
	["string", "\"foo \\\"bar\\\" baz\""],
	["string", "'foo \\'bar\\' baz'"],
	["string", "\"it's\""],
	["string", "\"\"\"a \"multi-line\"\r\nstring\"\"\""],
	["string", "'''another\r\none'''"],
	["string", "\"# not a comment\""],
	["string", "\"line one\r\n# not a comment, it's still a string\""],
	["operator", "+"],
	["string", "'q'"],
	["string", "\"\"\"\"\"has \"\"\" inside\"\"\"\"\""],
	["string", "'''''five'''''"],
	["string", "\"\""]
]

