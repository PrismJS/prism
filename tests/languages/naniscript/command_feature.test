@wait
@ wait
@wait 1
@char Kohaku pos:50 look:right
@char Kohaku.Happy
@print Hello, world
@print "Hello, world!"
@print "Hello \"World\""
@print Say "Hi" please
@back wait!
@back !wait
@bgm Piano fade:1.5 loop:false
@camera pos:0,10 offset:-1,0.5 time:2
@print Time: 12:00
@print Hello!
@print Hello;world
[wait 1]
Text with [i]inline[-] commands [wait 1] and [ ] [-] [>] [<]
Kohaku: Hello [char Kohaku.Happy pos:50]world
[print "a]b" pos:50]
\[not a command\]
[unclosed

