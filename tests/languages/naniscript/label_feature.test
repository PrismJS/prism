#Start
# Start
	# Indented
# Multi word label
@goto Script001
@goto Script001#AfterStorm
@goto #Epilogue hold!
@gosub #Sub
@choice "Go" goto:#Epilogue
[goto #Next]

----------------------------------------------------

[
	["label", ["#Start"]],
	["label", ["# Start"]],
	["label", ["# Indented"]],
	["label", ["# Multi word label"]],
	["command", [
		["command-name", "@goto"],
		["label", "Script001"]
	]],
	["command", [
		["command-name", "@goto"],
		["label", "Script001#AfterStorm"]
	]],
	["command", [
		["command-name", "@goto"],
		["label", "#Epilogue"],
		["parameter-name", [
			"hold",
			["boolean", "!"]
		]]
	]],
	["command", [
		["command-name", "@gosub"],
		["label", "#Sub"]
	]],
	["command", [
		["command-name", "@choice"],
		["string", ["\"Go\""]],
		["parameter-name", [
			"goto",
			["punctuation", ":"]
		]],
		["label", "#Epilogue"]
	]],
	["inline-command", [
		["punctuation", "["],
		["command", [
			["command-name", "goto"],
			["label", "#Next"]
		]],
		["punctuation", "]"]
	]]
]

----------------------------------------------------

Checks for labels and navigation targets.
