/- commented-node
node /- 1 2 3
node /- key=value
node {
    /- commented-child
    real-child
}
node 1 /- // stuff
2 3
node "string"/-foo=1 bar
node /- (u8)42 /-(t)key=(t)"value" 3
node 1 /- { child } { real }
/-this-is-commented {
    this entire node {
        is gone "with } brace"
    }
}
after
/-node 1 \
    2 /* } */ 3
parent { /-child; other }
/-node r#"raw"# // trailing comment
/-
spread-out-node
/-raw #"""
    } still raw
    """#
kept
node \
    /- arg kept

----------------------------------------------------

